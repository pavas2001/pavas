{
  "name": "pixberry-erp",
  "version": "1.0.0",
  "description": "Pixberry ERP — café management: QR ordering with geofence, POS, KDS, tables, reservations, inventory, recipes, purchasing, staff, loyalty and reports.",
  "private": true,
  "main": "app.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning app.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "restore": "node --disable-warning=ExperimentalWarning scripts/restore.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "qrcode": "^1.5.4"
  }
}
